# Application Settings
PROJECT_NAME="Automotive Engineering AI Agent Platform"
API_V1_STR="/api/v1"
SECRET_KEY="automotive-super-secret-key-change-in-prod-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Local SQLite fallback: sqlite:///./automotive_platform.db
# PostgreSQL: postgresql://autoai_user:autoai_password@localhost:5432/automotive_db
DATABASE_URL="sqlite:///./automotive_platform.db"

# Vector Database
CHROMA_PERSIST_DIRECTORY="./chroma_data"

# AI / LLM Configuration
# Options: openrouter | openai | ollama | demo
LLM_PROVIDER="openrouter"
LLM_API_KEY=""
LLM_BASE_URL="https://openrouter.ai/api/v1"
LLM_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"

# Frontend API URL
BACKEND_API_URL="http://127.0.0.1:8000/api/v1"
